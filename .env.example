# QQ 机器人凭证 (https://q.qq.com 开放平台获取)
QQ_BOT_APPID=your_app_id_here
QQ_BOT_SECRET=your_client_secret_here

# DeepSeek API 配置
# 获取地址: https://platform.deepseek.com/
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com

# OpenViking 上下文数据库配置（可选）
# 本地部署: 默认 http://localhost:1933，无需 API Key
# 云上版本: 填写火山引擎 OpenViking endpoint，需填写 API Key
# 文档: https://www.volcengine.com/docs/84313/2381937
OPENVIKING_ENABLED=false
OPENVIKING_BASE_URL=http://localhost:1933
OPENVIKING_API_KEY=
OPENVIKING_ACCOUNT=
OPENVIKING_USER=

# Web 渠道（聊天页 + 管理后台）
# 监听地址/端口在 conf/trpc_go.yaml 的 server.service（trpc.trpg.web.Admin）中配置
WEB_ENABLED=true
# trpc-go 配置文件路径（Web 服务地址在此文件内配置）
TRPC_CONF=./conf/trpc_go.yaml
# Web 聊天页访问令牌（留空则不校验）
WEB_CHAT_TOKEN=
# 管理后台 Bearer 令牌（留空时仅允许本机 127.0.0.1 访问）
ADMIN_TOKEN=

# 运行时配置存储（SQLite，管理后台修改即时生效）
CONFIG_DB=./data/app.db

# 世界状态与记忆存储目录
WORLD_DIR=./data/worlds
MEMORY_DIR=./data/memories

# 记忆抽取开关（也可在管理后台热更新）
MEMORY_EXTRACTOR_ENABLED=true
