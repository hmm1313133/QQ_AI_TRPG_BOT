# DeepSeek API 配置
# 获取地址: https://platform.deepseek.com/
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com

# Web 渠道（聊天页 + 管理后台）
# 监听地址/端口在 conf/trpc_go.yaml 的 server.service（trpc.voyage.web.Admin）中配置
WEB_ENABLED=true
# trpc-go 配置文件路径（Web 服务地址在此文件内配置）
TRPC_CONF=./conf/trpc_go.yaml
# Web 聊天页访问令牌（留空则不校验）
WEB_CHAT_TOKEN=
# 管理后台 Bearer 令牌（留空时仅允许本机 127.0.0.1 访问）
ADMIN_TOKEN=

# 运行时配置存储（SQLite，管理后台修改即时生效）
CONFIG_DB=./data/app.db

# LLM 调试日志（开发期排查提示词用）
# 默认开启：每次 LLM 调用的完整输入/输出追加到 data/llm_debug/<日期>.jsonl
# 设为 0 关闭；LLM_DEBUG_DIR 可自定义输出目录
LLM_DEBUG_LOG=1
# LLM_DEBUG_DIR=./data/llm_debug

# 世界状态存储目录（旧 JSON 目录自动迁移用）
WORLD_DIR=./data/worlds
